shape Hud
  surface: bool
  travelling: bool
  selected: bool
  occupied: bool
  title: string
  body: string
  object_id: string
  x: number
  y: number
  z: number
  count: number
shape SurfaceNotes
  json: string
  error: string
  ready: bool
shape SaveResult
  ok: bool
  error: string

component Ansuz
  state editing = false
  state title = ""
  state body = ""
  state cellX = 0
  state cellY = 0
  state cellZ = 0
  resource library = loadSurfaceNotes() as shape SurfaceNotes
  resource hud = exactSurface("world") as shape Hud
  mutation saved as shape SaveResult refreshes library then afterSave
  derive saveError = match saved { case some(r) => r.error, case none => "" }
  action openEditor
    title = hud.title
    body = hud.body
    cellX = hud.x
    cellY = hud.y
    cellZ = hud.z
    editing = true
  action editTitle(value: string)
    title = value
  action editBody(value: string)
    body = value
  action cancel
    editing = false
  action save
    if (title.trim() != "" or body.trim() != "") and not pending(saved)
      send saved = saveSurfaceNote(cellX, cellY, cellZ, title, body)
  action afterSave
    if match saved { case some(r) => r.ok, case none => false }
      editing = false
  view
    main width="100%" height="100%" background-color="#090909" color="#dedede"
      if library.ready
        canvas surface=world(records=library.json, editing=editing) testId="world" width="100%" height="100%" position="relative"
          row position="absolute" top="env(safe-area-inset-top, 0px)" left=0 right=0 padding=20 justify-content="space-between" align-items="center" gap=12
            text "ANSUZ" font-size="1.1rem" letter-spacing="0.22em" font-weight=600
            row gap=8
              button action="recenter" testId="reset" disabled=(editing or hud.travelling) aria-label="Return to the starting landscape" padding=10 border-radius=10 background-color="#252525"
                text "Recenter"
              if hud.surface
                button action="ascend" testId="ascend" disabled=(editing or hud.travelling) padding=10 border-radius=10 background-color="#b7d8de" color="#090909"
                  text "Ascend"
              else
                button action="descend" testId="descend" disabled=hud.travelling padding=10 border-radius=10 background-color="#b7d8de" color="#090909"
                  text "Descend"
          if editing
            column position="absolute" bottom="max(16px, env(safe-area-inset-bottom, 0px))" right=16 width="min(340px, calc(100% - 32px))" box-sizing="border-box" padding=20 gap=12 border-radius=12 background-color="#15191af5" testId="editor"
              text "On this surface" font="-exact-headline"
              text "Title" font="-exact-caption1" color="#c2cbcd"
              input value=title input=editTitle box-sizing="border-box" aria-label="Title" testId="note-title" width="100%" padding=10 background-color="#262b2c" color="#eeeeee" border-radius=6
              text "Note" font="-exact-caption1" color="#c2cbcd"
              textarea value=body input=editBody box-sizing="border-box" aria-label="Note" testId="note-body" width="100%" height=130 padding=10 background-color="#262b2c" color="#eeeeee" border-radius=6
              if saveError != "" or failed(saved)
                text (failed(saved) ? "Couldn't save. Your draft is still here." : saveError) color="#f0acac" font="-exact-caption1" testId="save-error"
              row gap=12 justify-content="flex-end"
                button press=cancel testId="cancel" disabled=pending(saved) padding=10
                  text "Cancel"
                button press=save testId="save" disabled=(pending(saved) or (title.trim() == "" and body.trim() == "")) padding=10 border-radius=8 background-color="#b7d8de" color="#090909"
                  text (pending(saved) ? "Saving…" : "Save")
          else
            if hud.selected
              column position="absolute" bottom="max(16px, env(safe-area-inset-bottom, 0px))" right=16 width="min(340px, calc(100% - 32px))" box-sizing="border-box" padding=20 gap=12 border-radius=12 background-color="#15191af5" testId="face-panel"
                text (hud.occupied ? hud.title : "Empty surface") font="-exact-headline" testId="face-title"
                if hud.occupied
                  text hud.body font="-exact-subheadline" max-height=120 overflow="auto" testId="face-body"
                row gap=8 align-items="center"
                  text "Clay tablet" font="-exact-caption1" color="#b3b3b3"
                  button action="turn-left" testId="tablet-left" aria-label="Turn tablet left" padding=10 background-color="#252525" border-radius=8
                    text "↶"
                  button action="turn-right" testId="tablet-right" aria-label="Turn tablet right" padding=10 background-color="#252525" border-radius=8
                    text "↷"
                row gap=12 justify-content="flex-end"
                  button action="clear" testId="deselect" padding=10
                    text "Close"
                  if hud.surface
                    button press=openEditor testId="add-note" disabled=(hud.travelling or library.error != "" or pending(library)) padding=10 border-radius=8 background-color="#b7d8de" color="#090909"
                      text (hud.occupied ? "Edit" : "Add a note")
                  else
                    text "Descend to work on this surface." font="-exact-caption1" color="#b3b3b3"
            else
              column position="absolute" bottom="max(20px, env(safe-area-inset-bottom, 0px))" left=20 right=20 align-items="center" gap=8
                text (hud.surface ? "Choose a top surface to add something." : "Explore the landscape. Descend to add something.") color="#b3b3b3" font="-exact-subheadline" testId="hint"
                row gap=12
                  button action="select-center" testId="select-center" disabled=hud.travelling padding=8 background-color="#252525" border-radius=8
                    text "Select centre"
                  if hud.surface
                    button action="closer" aria-label="Zoom in" testId="closer" padding=8
                      text "+"
                    button action="farther" aria-label="Zoom out" testId="farther" padding=8
                      text "−"
                text (hud.surface ? "Drag to move · scroll to zoom" : "Drag or scroll to rotate") color="#888888" font="-exact-caption1"
          if library.error != ""
            text library.error position="absolute" top=80 left=20 right=20 color="#f0acac" testId="load-error"
      else
        column width="100%" height="100%" align-items="center" justify-content="center" gap=12
          text "Opening your surface…" color="#b3b3b3"
          if failed(library)
            text "Could not open local notes. Reload to try again." color="#f0acac"
