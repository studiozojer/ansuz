use AccountRow, AccountAvatar from "./signin.contract"

shape Media
  prefersReducedMotion: bool

fn bounded(value: number, port: number, size: number): number = min(max(value, 0 - max(0, (port - size) / 2 - 12)), max(0, (port - size) / 2 - 12))

shape OrbitHud
  cell: string
  mode: string
  motion: string
  altitude: number
  lab_status: string
  lab_seconds: number
  lab_samples: number
  lab_observed: number
  lab_contacts: number
  lab_delivered: number
  lab_recording: bool
  lab_replaying: bool
  lab_ready: bool
  lab_error: string
  lab_element: number
  element_phase: string
  element_energy: number
  element_charge: number

shape GestureTake
  id: string
  label: string
  expected: string
  json: string

shape GestureTakes
  items: GestureTake[]
  error: string
  ready: bool
  unassigned: GestureTake[]

shape GestureSaved
  ok: bool
  error: string

shape CloudTake
  id: string
  label: string
  expected: string
  digest: string
  asset: string
  captured: number

shape RecordingCloud
  items: CloudTake[]
  connected: bool
  status: string
  error: string
  more: bool
  shared: bool
  ready: bool
  principal: string

shape CloudLoaded
  json: string
  error: string
  expected: string

shape LoginInput
  input: string
  value: string
  valid: bool

shape AccountSuggestion
  did: string
  handle: string
  displayName: string
  avatar: string

shape AccountSuggestions
  query: string
  items: AccountSuggestion[]
  available: bool
  complete: bool

shape LabTime
  epochAtZero: number

component Ansuz
  state study = "orbit"
  state labFlat = true
  state labElement = 0
  derive elementHelp = labElement == 1 ? "Hold the cube still. Draw slowly, then strike fast." : (labElement == 2 ? "Grab the cube. Trace a steady circle around its center." : (labElement == 3 ? "Sweep upward, then drive back down. Start anywhere in the field." : "Grab the cube. Fan it back and forth through the field."))
  action chooseElement(value: number)
    labElement = value
    labFlat = true
    postMessage("lab:reset", "world")
  action labReplay
    labElement = orbit.lab_element
    if orbit.lab_element > 0
      labFlat = true
    postMessage("lab:replay", "world")
  state cloudTab = false
  state cloudHandle = ""
  state cloudRevision = 0
  state labAccount = ""
  state labOwner = ""
  state labCapturedAt = 0
  state showDeviceOnly = false
  action cloudChooseTab(value: bool)
    cloudTab = value
  // Deliberate launch identity: never paint a kept private answer before checking the saved account.
  resource cloudState = recordingCloud(cloudRevision, labTime.epochAtZero) as shape RecordingCloud
  mutation cloudResult as shape RecordingCloud refreshes cloudState
  mutation cloudDownload as shape CloudLoaded refreshes cloudState then cloudReceived
  derive cloudJson = match cloudDownload { case some(t) => t.json, case none => "" }
  derive cloudNote = match cloudDownload { case some(t) => t.expected, case none => "" }
  derive cloudLoadError = match cloudDownload { case some(t) => t.error, case none => "" }
  state accountQuery = ""
  state selectedHandle = ""
  state accountsOpen = false
  resource accountInput = loginInput(cloudHandle) as shape LoginInput
  derive canConnect = accountInput.input == cloudHandle and accountInput.valid and not pending(accountInput) and not pending(cloudResult) and not pending(cloudDownload) and cloudState.ready
  resource suggestions = lookupAccounts(accountQuery) as shape AccountSuggestions
  task searchAccounts when not cloudState.connected and cloudTab and labLibrary and cloudHandle.trim() != accountQuery and cloudHandle != selectedHandle key=cloudHandle
    after(250, searchAccounts)
  action searchAccounts
    accountQuery = cloudHandle.trim()
  action suggestionsToggled(e: ToggleEvent)
    accountsOpen = e.newState == "open"
  action openSuggestions
    if cloudHandle.trim().length >= 2 and not cloudHandle.trim().startsWith("did:") and cloudHandle != selectedHandle
      showPopover("account-suggestions", source="account-entry")
  action accountKey(k: string)
    if k == "Escape"
      preventDefault()
      hidePopover("account-suggestions")
    if k == "ArrowDown" and suggestions.items.length > 0 and suggestions.query == cloudHandle.trim()
      preventDefault()
      showPopover("account-suggestions", source="account-entry")
      focus("suggestion-0")
  action chooseAccount(value: string)
    hidePopover("account-suggestions")
    cloudHandle = value
    selectedHandle = value
    accountQuery = ""
    focus("account-handle")
  action suggestionKey(i: number, k: string)
    if k == "Escape"
      preventDefault()
      hidePopover("account-suggestions")
      focus("account-handle")
    if k == "ArrowDown" and i + 1 < suggestions.items.length
      preventDefault()
      focus(`suggestion-${i + 1}`)
    if k == "ArrowUp"
      preventDefault()
      if i == 0
        focus("account-handle")
      else
        focus(`suggestion-${i - 1}`)
  action cloudHandleChange(text: string)
    cloudHandle = text
    selectedHandle = ""
    accountQuery = ""
    if text.trim().length >= 2 and not text.trim().startsWith("did:")
      showPopover("account-suggestions", source="account-entry")
    else
      hidePopover("account-suggestions")
  action cloudConnect
    if canConnect
      hidePopover("account-suggestions")
      accountQuery = ""
      selectedHandle = cloudHandle
      send cloudResult = connectRecordings(accountInput.value, labTime.epochAtZero + performanceNow())
  task watchAccount when cloudState.ready and labAccount != cloudState.principal key=cloudState.principal
    after(1, clearAccountView)
  action clearAccountView
    labAccount = cloudState.principal
    labNote = ""
    labTrace = ""
    labImport = ""
    labOwner = ""
    cloudDownload = none
    if not pending(labSaved)
      labSaved = none
    showDeviceOnly = false
    postMessage("lab:forget", "world")
  action cloudSync
    send cloudResult = syncRecordings(labTime.epochAtZero + performanceNow())
  action cloudMore
    send cloudResult = moreRecordings(labTime.epochAtZero + performanceNow())
  action cloudDisconnect
    clearAccountView()
    send cloudResult = disconnectRecordings(labTime.epochAtZero + performanceNow())
    cloudRevision = cloudRevision + 1
    refresh cloudState
  action cloudShare
    send cloudResult = shareRecordings(not cloudState.shared, labTime.epochAtZero + performanceNow())
  action cloudFetch(digest: string)
    send cloudDownload = loadCloudTake(digest, labTime.epochAtZero + performanceNow())
  action cloudReceived
    if cloudJson != ""
      labLoad(cloudJson, cloudNote)
  state labNote = ""
  state labTrace = ""
  state labImport = ""
  state labLoadVersion = 0
  state labLibrary = false
  state labCopied = false
  resource labTime = exactTime() as shape LabTime
  resource labTakes = gestureTakes(cloudState.principal, cloudRevision, labTime.epochAtZero) as shape GestureTakes
  mutation labSaved as shape GestureSaved refreshes labTakes
  derive labSaveError = match labSaved { case some(s) => s.error, case none => "" }
  action openLab
    study = "lab"
  action labTarget(flat: bool)
    labFlat = flat
    labElement = 0
  action labCommand(command: string)
    postMessage(`lab:${command}`, "world")
  action labRecord
    labOwner = cloudState.principal
    labCapturedAt = labTime.epochAtZero + performanceNow()
    labCopied = false
    postMessage(`lab:record|${performanceNow()}`, "world")
  action labObserve(phase: string, e: PointerEvent)
    postMessage(`finger|${phase}|${e.pointerId}|${e.offsetX}|${e.offsetY}|${e.buttons}|${performanceNow()}`, "world")
  action labReceive(text: string)
    labTrace = text
    send labSaved = saveGestureTake(text, labNote, labCapturedAt, labOwner)
  action labSaveAgain
    send labSaved = saveGestureTake(labTrace, labNote, labCapturedAt, labOwner)
  action labEditNote(text: string)
    labNote = text
  action labShowLibrary
    labLibrary = not labLibrary
  action labLoad(text: string, note: string)
    if not pending(labSaved)
      labSaved = none
    labTrace = text
    labNote = note
    labLibrary = false
    labCopied = false
    labImport = text
    labLoadVersion = labLoadVersion + 1
  action labCopy(text: string)
    copyText(text)
    labCopied = true
  action claimDeviceTake(id: string)
    send labSaved = claimGestureTake(id, cloudState.principal)
  action toggleDeviceOnly
    showDeviceOnly = not showDeviceOnly
  action labDelete(id: string)
    send labSaved = deleteGestureTake(id, cloudState.principal)
  state orbitMode = 0
  state orbitHome = 0
  resource orbit = exactSurface("world") as shape OrbitHud
  action showStudy(next: string)
    study = next
  action orbitChoose(next: number)
    orbitMode = next
  action orbitReset
    orbitHome = orbitHome + 1
  resource media = exactViewport() as shape Media
  state mode = "drag"
  state x = 0
  state y = 0
  state zoom = 1
  state portW = 360
  state portH = 400
  state selected = false
  derive motion = media.prefersReducedMotion ? "none" : "translate -exact-spring(300, 30, 1), scale -exact-spring(300, 30, 1)"
  derive instruction = mode == "drag" ? "Move it. Let go. It stays." : (mode == "glide" ? "Flick it. Catch it while it moves." : "Pull it away. Catch its return.")
  action geometry(bw: number, bh: number, pw: number, ph: number)
    portW = pw
    portH = ph
  action release(px: number, py: number, scale: number, vx: number, vy: number, vs: number)
    let z = min(max(scale, 0.65), 1.6)
    let coast = mode == "glide" and not media.prefersReducedMotion ? 0.16 : 0
    zoom = z
    x = mode == "spring" ? 0 : bounded(px + min(max(vx, -1600), 1600) * coast, portW, 176 * z)
    y = mode == "spring" ? 0 : bounded(py + min(max(vy, -1600), 1600) * coast, portH, 216 * z)
  action reset
    x = 0
    y = 0
    zoom = 1
    selected = false
  action choose(next: string)
    mode = next
    reset()
  action select
    selected = not selected
  action resize(delta: number)
    zoom = min(max(zoom + delta, 0.65), 1.6)
    x = 0
    y = 0
  action nudge(dx: number, dy: number)
    x = bounded(x + dx, portW, 176 * zoom)
    y = bounded(y + dy, portH, 216 * zoom)
  view
    main width="100%" height="100%"
      if study == "touch"
        column width="100%" height="100%" box-sizing="border-box" padding-top="env(safe-area-inset-top, 0px)" padding-bottom="env(safe-area-inset-bottom, 0px)" background-color="#0d0f11" color="#e5e7e8" color-scheme="dark" accent-color="#b8d8d5"
          row padding="16px" gap=8 align-items="center" justify-content="space-between" flex-shrink=0
            column gap=4
              text "ANSUZ" letter-spacing="0.22em" font-size=16 font-weight=600
              text "Interaction playground" font-size=12 color="#969ea4"
            button press=showStudy("orbit") testId="orbit-study" min-width=64 min-height=44 padding=10 border-radius=12 background-color="#23282c"
              text "Orbit"
            button press=reset testId="reset" aria-label="Reset the sample object" min-width=64 min-height=44 padding=10 border-radius=12 background-color="#23282c"
              text "Reset"
          row padding="0px 20px 12px" gap=6 flex-shrink=0
            button press=choose("drag") testId="mode-drag" aria-pressed=(mode == "drag") flex=1 min-height=44 padding=10 border-radius=12 background-color=(mode == "drag" ? "#b8d8d5" : "#1a1f23") color=(mode == "drag" ? "#101617" : "#afb7bd")
              text "Drag"
            button press=choose("glide") testId="mode-glide" aria-pressed=(mode == "glide") flex=1 min-height=44 padding=10 border-radius=12 background-color=(mode == "glide" ? "#b8d8d5" : "#1a1f23") color=(mode == "glide" ? "#101617" : "#afb7bd")
              text "Glide"
            button press=choose("spring") testId="mode-spring" aria-pressed=(mode == "spring") flex=1 min-height=44 padding=10 border-radius=12 background-color=(mode == "spring" ? "#b8d8d5" : "#1a1f23") color=(mode == "spring" ? "#101617" : "#afb7bd")
              text "Spring"
          text instruction testId="instruction" padding="0px 20px 12px" font-size=14 color="#afb7bd" text-align="center" flex-shrink=0
          box testId="stage" position="relative" flex=1 min-height=160 margin="0px 12px" overflow="hidden" border-radius=20 background-color="#121619" display="flex" align-items="center" justify-content="center"
            box position="absolute" top=0 bottom=0 left="50%" width=1 background-color="#242b30" pointer-events="none"
            box position="absolute" left=0 right=0 top="50%" height=1 background-color="#242b30" pointer-events="none"
            text "01 / TOUCH STUDY" position="absolute" top=16 left=16 font-size=10 letter-spacing="0.12em" color="#78858e" pointer-events="none"
            box id="manipulation" testId="manipulation" position="absolute" left=0 top=0 width="100%" height="100%" box-sizing="border-box" padding=0 border-width=0 translate=`${x}px ${y}px` scale=zoom transition=motion display="flex" align-items="center" justify-content="center"
              box testId="sample" width=176 height=216 flex-shrink=0 position="relative"
                column position="absolute" inset=0 padding=20 box-sizing="border-box" justify-content="space-between" border-radius=18 border-style="solid" border-width=2 border-color=(selected ? "#d9bb75" : "#708d91") background-color=(selected ? "#292820" : "#213034") pointer-events="none"
                  row justify-content="space-between" align-items="center"
                    text "ANSUZ / 01" font-size=10 letter-spacing="0.1em" color="#b7c8c9"
                    box width=6 height=6 border-radius=3 background-color=(selected ? "#d9bb75" : "#b8d8d5")
                  column gap=8
                    text "A beginning" font-size=22 font-weight=600
                    text "An object, wherever you put it." font-size=13 line-height="18px" color="#b7c8c9"
                  text (selected ? "SELECTED" : "TAP TO SELECT") font-size=10 letter-spacing="0.12em" color=(selected ? "#e4c881" : "#b7c8c9")
                box testId="handle" transformDragFor="manipulation" transformgeometry=geometry transformrelease=release press=select touch-action="none" position="absolute" inset=0 aria-label="Sample object. Tap to select, drag to move, pinch to resize." role="button" tabindex=0
          column padding="12px 16px 16px" gap=10 flex-shrink=0 align-items="center"
            text (selected ? "Selected · pinch to resize" : "Drag the card · pinch to resize") testId="selection" font-size=13 color="#b7c2c8"
            row gap=6 align-items="center" justify-content="center" flex-wrap="wrap"
              button press=resize(-0.15) testId="zoom-out" aria-label="Make the object smaller" min-width=44 min-height=44 border-radius=10 background-color="#1a1f23"
                text "−"
              text `${round(zoom * 100)}%` testId="zoom" width=48 text-align="center" font-size=12
              button press=resize(0.15) testId="zoom-in" aria-label="Make the object larger" min-width=44 min-height=44 border-radius=10 background-color="#1a1f23"
                text "+"
              button press=nudge(-24, 0) testId="left" aria-label="Move left" min-width=44 min-height=44 border-radius=10
                text "←"
              button press=nudge(0, -24) testId="up" aria-label="Move up" min-width=44 min-height=44 border-radius=10
                text "↑"
              button press=nudge(0, 24) testId="down" aria-label="Move down" min-width=44 min-height=44 border-radius=10
                text "↓"
              button press=nudge(24, 0) testId="right" aria-label="Move right" min-width=44 min-height=44 border-radius=10
                text "→"
            text (media.prefersReducedMotion ? "Reduced motion · no glide or spring animation" : "A sample to play with. Reset whenever you like.") testId="motion-preference" font-size=11 color="#78858e" text-align="center"
      else if study == "lab"
        column width="100%" height="100%" box-sizing="border-box" padding-top="env(safe-area-inset-top, 0px)" padding-bottom="env(safe-area-inset-bottom, 0px)" background-color="#0d0d0d" color="#e7e7e7" color-scheme="dark" accent-color="#dddddd"
          row padding="12px 16px" gap=8 align-items="center" justify-content="space-between" flex-shrink=0
            column gap=4
              text "ANSUZ" letter-spacing="0.22em" font-size=16 font-weight=600
              text "Gesture lab" font-size=12 color="#9e9e9e"
            button press=labShowLibrary testId="lab-library" min-height=44 padding=10 border-radius=12 background-color="#232323" disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Takes"
            button press=showStudy("orbit") testId="lab-back" min-height=44 padding=10 border-radius=12 background-color="#232323" disabled=orbit.lab_recording
              text "Orbit"
          row padding="0px 16px 10px" gap=6 flex-shrink=0
            button press=labTarget(true) testId="lab-flat" aria-pressed=labFlat flex=1 min-height=44 border-radius=12 background-color=(labFlat ? "#dddddd" : "#202020") color=(labFlat ? "#111111" : "#b7b7b7") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "2D target"
            button press=labTarget(false) testId="lab-3d" aria-pressed=(not labFlat) flex=1 min-height=44 border-radius=12 background-color=(labFlat ? "#202020" : "#dddddd") color=(labFlat ? "#b7b7b7" : "#111111") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "3D sphere"
          row padding="0px 12px 8px" gap=4
            button press=chooseElement(0) testId="element-motion" flex=1 min-height=44 border-radius=8 background-color=(labElement == 0 ? "#454545" : "#202020") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Motion" font-size=12
            button press=chooseElement(1) testId="element-fire" flex=1 min-height=44 border-radius=8 background-color=(labElement == 1 ? "#633528" : "#202020") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Fire" font-size=12
            button press=chooseElement(2) testId="element-water" flex=1 min-height=44 border-radius=8 background-color=(labElement == 2 ? "#284559" : "#202020") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Water" font-size=12
            button press=chooseElement(3) testId="element-earth" flex=1 min-height=44 border-radius=8 background-color=(labElement == 3 ? "#4b4436" : "#202020") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Earth" font-size=12
            button press=chooseElement(4) testId="element-air" flex=1 min-height=44 border-radius=8 background-color=(labElement == 4 ? "#3a474b" : "#202020") disabled=(orbit.lab_recording or orbit.lab_replaying)
              text "Air" font-size=12
          box testId="lab-stage" position="relative" flex=1 min-height=170 margin="0px 12px" overflow="hidden" border-radius=16 background-color="#0b0b0b"
            canvas surface=world(mode=orbitMode, home=orbitHome, reduced_motion=media.prefersReducedMotion, lab=true, flat=labFlat, element=labElement, take=labImport, take_revision=labLoadVersion) testId="world" width="100%" height="100%" position="absolute" inset=0 touch-action="none" pointerdown=labObserve("down") pointermove=labObserve("move") pointerup=labObserve("up") message=labReceive aria-label="Gesture recording field. Flick, catch, and hold the target." tabindex=0
              row position="absolute" left=14 right=14 top=14 justify-content="space-between" pointer-events="none"
                text orbit.lab_status testId="lab-status" font-size=10 letter-spacing="0.1em" color="#cccccc"
                text `${round(orbit.lab_seconds * 10) / 10}s` testId="lab-duration" font-size=12 font-variant-numeric="tabular-nums" color="#aaaaaa"
              row position="absolute" bottom=14 left=14 right=14 justify-content="space-between" pointer-events="none"
                text "FINGER + RESPONSE" font-size=10 letter-spacing="0.08em" color="#888888"
                text (labElement == 0 ? orbit.motion : orbit.element_phase) testId="lab-contact" font-size=10 color="#cccccc"
            if labElement > 0
              column position="absolute" top=38 left=14 right=14 gap=5 pointer-events="none"
                text elementHelp font-size=12 color="#aaaaaa"
                row gap=10
                  text `CHARGE ${round(orbit.element_charge * 100)}%` testId="element-charge" font-size=10 color="#999999" font-variant-numeric="tabular-nums"
                  text `ENERGY ${round(orbit.element_energy * 100)}%` testId="element-energy" font-size=10 color="#999999" font-variant-numeric="tabular-nums"
            if not labFlat
              box position="absolute" left="50%" top="50%" width=4 height=4 background-color="#ffffff" pointer-events="none"
            if labLibrary
              column position="absolute" inset=0 overflow-y="auto" padding=16 gap=10 background-color="#111111"
                row gap=8
                  button press=cloudChooseTab(false) min-height=44 flex=1 background-color=(cloudTab ? "#191919" : "#353535") border-radius=8
                    text "Device"
                  button press=cloudChooseTab(true) testId="cloud-tab" min-height=44 flex=1 background-color=(cloudTab ? "#353535" : "#191919") border-radius=8
                    text "Cloud"
                if cloudTab
                  text "ANSUZ RECORDING HISTORY" font-size=10 letter-spacing="0.12em" color="#999999"
                  if not cloudState.connected
                    text "Log in with your everything account." font-size=15
                    text "Your recordings stay private. Device-only takes are added to an account only when you choose." font-size=12 color="#aaaaaa"
                    row id="account-entry" gap=8 align-items="stretch"
                      input id="account-handle" value=cloudHandle input=cloudHandleChange submit=cloudConnect press=openSuggestions key=accountKey testId="cloud-handle" placeholder="Name, handle or DID" aria-label="Everything account handle or DID" aria-controls="account-suggestions" aria-expanded=accountsOpen autocomplete="username" autocapitalize="none" spellcheck=false enterkeyhint="go" flex=1 min-width=0 min-height=48 box-sizing="border-box" padding=10 background-color="#252525" color="#dddddd" border-radius=8
                      button press=cloudConnect testId="cloud-login" min-width=72 min-height=48 background-color="#dddddd" color="#111111" border-radius=8 disabled=(not canConnect)
                        text "Log in"
                    column id="account-suggestions" testId="account-suggestions" popover="auto" toggle=suggestionsToggled role="group" aria-label="Account suggestions" position="absolute" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline" margin="8px 0" width="min(360px, calc(100vw - 48px))" max-height="min(320px, 45vh)" overflow-y="auto" box-sizing="border-box" padding=6 gap=2 background-color="#202020" color="#dddddd" border-width=0 border-radius=10 box-shadow="0 8px 24px #00000066"
                      if pending(suggestions) or accountQuery != cloudHandle.trim()
                        text "Looking for accounts…" padding=12 font-size=13 color="#aaaaaa" aria-live="polite"
                      if accountQuery == cloudHandle.trim() and suggestions.query == accountQuery and not pending(suggestions)
                        if not suggestions.available
                          text "Suggestions unavailable. You can still enter your full handle or DID." testId="suggestions-error" padding=12 font-size=13 color="#aaaaaa"
                        else
                          if suggestions.items.length > 0
                            for person, i in suggestions.items key=person.did
                              button id=`suggestion-${i}` press=chooseAccount(person.handle) key=suggestionKey(i) class=AccountRow testId=`suggestion-${i}` aria-label=`Use @${person.handle}` min-height=52 padding=10 border-width=0 border-radius=6 color="#dddddd" text-align="left"
                                row gap=10 align-items="center" min-width=0
                                  AccountAvatar(src=person.avatar, label=(person.displayName != "" ? person.displayName : person.handle))
                                  column gap=3 min-width=0 flex=1 align-items="flex-start"
                                    text (person.displayName != "" ? person.displayName : person.handle) font-size=15 text-align="left"
                                    text `@${person.handle}` font-size=12 color="#aaaaaa" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%" text-align="left"
                          else
                            text "No matching account found. You can still enter your full handle or DID." testId="suggestions-empty" padding=12 font-size=13 color="#aaaaaa"
                    text "Searches public Bluesky and Jera accounts." font-size=11 color="#999999"
                    if pending(cloudResult)
                      button press=cloudDisconnect min-height=44 background-color="#252525" border-radius=8
                        text "Cancel sign-in"
                  else
                    text cloudState.principal testId="account-did" font-size=11 overflow-wrap="anywhere" color="#cccccc"
                    text "Sync uploads only this account’s saved takes." font-size=12 color="#aaaaaa"
                    row gap=8
                      button press=cloudSync testId="cloud-sync" min-height=44 flex=1 background-color="#dddddd" color="#111111" border-radius=8 disabled=(pending(cloudResult) or pending(cloudDownload))
                        text "Sync"
                      button press=cloudDisconnect min-height=44 flex=1 background-color="#252525" border-radius=8
                        text "Sign out"
                    button press=cloudShare testId="cloud-share" min-height=44 background-color="#252525" border-radius=8 disabled=(pending(cloudResult) or pending(cloudDownload))
                      text (cloudState.shared ? "Revoke agent access" : "Share history with studio agent")
                    text (cloudState.shared ? "Studio agent can read and download your original takes." : "History is private to this account.") font-size=12 color="#aaaaaa"
                    for take in cloudState.items key=take.id
                      column padding=12 gap=8 background-color="#191919" border-radius=12
                        text take.label font-size=15 font-weight=500
                        text formatDate(take.captured, 0, "iso") font-size=10 color="#999999"
                        text take.expected font-size=12 color="#aaaaaa"
                        button press=cloudFetch(take.digest) min-height=44 background-color="#303030" border-radius=8 disabled=(pending(cloudResult) or pending(cloudDownload))
                          text "Load for replay"
                    if cloudState.more
                      button press=cloudMore min-height=44 background-color="#252525" border-radius=8 disabled=(pending(cloudResult) or pending(cloudDownload))
                        text "Older takes"
                  if pending(cloudResult) or pending(cloudDownload)
                    text "Working…" font-size=12 color="#dddddd"
                  text cloudState.status font-size=12 color="#aaaaaa"
                  text cloudState.error font-size=12 color="#e0bbbb"
                  text cloudLoadError font-size=12 color="#e0bbbb"
                else
                  text (cloudState.connected ? "THIS ACCOUNT · ON THIS DEVICE" : "DEVICE ONLY · NOT ASSIGNED TO AN ACCOUNT") font-size=10 letter-spacing="0.08em" color="#999999"
                  if labTakes.items.length == 0
                    text (labTakes.ready ? "No takes yet. Record a gesture to begin." : "Loading device takes…") font-size=14 color="#aaaaaa"
                  for take in labTakes.items key=take.id
                    column padding=12 gap=8 background-color="#191919" border-radius=12
                      text take.label font-size=15 font-weight=500
                      if take.expected != ""
                        text take.expected font-size=12 color="#aaaaaa"
                      row gap=8
                        button press=labLoad(take.json, take.expected) min-height=44 flex=1 border-radius=8 background-color="#303030"
                          text "Load"
                        button press=labCopy(take.json) min-height=44 flex=1 border-radius=8 background-color="#303030"
                          text "Copy JSON"
                        button press=labDelete(take.id) disabled=pending(labSaved) min-height=44 min-width=58 border-radius=8 background-color="#202020" aria-label="Delete this saved take"
                          text "Delete"
                  if cloudState.connected and labTakes.unassigned.length > 0
                    button press=toggleDeviceOnly testId="unassigned-takes" min-height=44 background-color="#252525" border-radius=8
                      text (showDeviceOnly ? "Hide device-only takes" : "Add device-only takes to this account")
                    if showDeviceOnly
                      text "Choosing Add assigns this take to the signed-in account. Sync uploads it afterward." font-size=12 color="#aaaaaa"
                      for take in labTakes.unassigned key=take.id
                        row gap=8 align-items="center"
                          text take.label flex=1 font-size=13
                          button press=claimDeviceTake(take.id) disabled=pending(labSaved) min-height=44 padding=10 background-color="#303030" border-radius=8
                            text "Add to this account"
                  text labSaveError color="#e0bbbb" font-size=12
                  text labTakes.error color="#e0bbbb" font-size=12
                  if labCopied
                    text "JSON copied." font-size=12 color="#cccccc"
          if not labLibrary
            column padding="10px 16px 14px" gap=8 flex-shrink=0
              row gap=6
                if orbit.lab_recording or orbit.lab_replaying
                  button press=labCommand("stop") testId="lab-stop" flex=1 min-height=44 border-radius=10 background-color="#dddddd" color="#111111"
                    text "Stop"
                else
                  button press=labRecord testId="lab-record" flex=1 min-height=44 border-radius=10 background-color="#dddddd" color="#111111" disabled=(not labTakes.ready or not cloudState.ready or pending(labSaved))
                    text "Record"
                button press=labReplay testId="lab-replay" flex=1 min-height=44 border-radius=10 background-color="#252525" disabled=(not orbit.lab_ready or orbit.lab_recording or orbit.lab_replaying)
                  text "Replay"
                button press=labCommand("reset") testId="lab-reset" min-width=64 min-height=44 border-radius=10 background-color="#252525" disabled=orbit.lab_recording
                  text "Center"
              input value=labNote input=labEditNote testId="lab-note" placeholder="What should this gesture do?" aria-label="Expected gesture behavior" min-height=44 padding=10 border-radius=10 background-color="#191919" color="#dddddd" font-size=13 disabled=(orbit.lab_recording or orbit.lab_replaying)
              text (orbit.lab_recording ? "Recording finger input and response · up to 20s" : (labElement == 0 ? "Record → flick → catch → tiny drag → hold → Stop" : "Record resets the exercise · release to rest · Center to restart")) testId="lab-help" font-size=11 color="#aaaaaa"
              if labSaveError != ""
                text labSaveError font-size=12 color="#e0bbbb"
                row gap=8
                  button press=labSaveAgain disabled=pending(labSaved) min-height=44 flex=1 background-color="#252525"
                    text "Retry save"
                  button press=labCopy(labTrace) min-height=44 flex=1 background-color="#252525"
                    text "Copy unsaved JSON"
              text `${orbit.lab_contacts} contacts · ${orbit.lab_delivered} delivered events` testId="lab-input-count" font-size=11 color="#aaaaaa"
              if orbit.lab_error != ""
                text orbit.lab_error font-size=12 color="#e0bbbb"
      else
        column width="100%" height="100%" box-sizing="border-box" padding-top="env(safe-area-inset-top, 0px)" padding-bottom="env(safe-area-inset-bottom, 0px)" background-color="#0d0d0d" color="#e7e7e7" color-scheme="dark" accent-color="#dddddd"
          row padding="16px" gap=8 align-items="center" justify-content="space-between" flex-shrink=0
            column gap=4
              text "ANSUZ" letter-spacing="0.22em" font-size=16 font-weight=600
              text "Orbital playground" font-size=12 color="#9e9e9e"
            button press=openLab testId="gesture-lab" min-height=44 padding=10 border-radius=12 background-color="#232323"
              text "Lab"
            button press=showStudy("touch") testId="touch-study" min-height=44 padding=10 border-radius=12 background-color="#232323" aria-label="Open the original touch playground"
              text "2D"
            button press=orbitReset testId="orbit-reset" min-height=44 padding=10 border-radius=12 background-color="#232323" aria-label="Reset orbital orientation"
              text "Reset"
          row padding="0px 20px 12px" gap=6 flex-shrink=0
            button press=orbitChoose(0) testId="spin-mode" aria-pressed=(orbitMode == 0) flex=1 min-height=44 padding=10 border-radius=12 background-color=(orbitMode == 0 ? "#dddddd" : "#1e1e1e") color=(orbitMode == 0 ? "#111111" : "#b7b7b7")
              text "Spin sphere"
            button press=orbitChoose(1) testId="fly-mode" aria-pressed=(orbitMode == 1) flex=1 min-height=44 padding=10 border-radius=12 background-color=(orbitMode == 1 ? "#dddddd" : "#1e1e1e") color=(orbitMode == 1 ? "#111111" : "#b7b7b7")
              text "Fly camera"
          text (orbitMode == 0 ? "Turn the sphere beneath a still camera." : "Travel at a fixed height above the sphere.") testId="orbit-instruction" padding="0px 20px 12px" font-size=14 color="#b0b0b0" text-align="center" flex-shrink=0
          box testId="orbit-stage" position="relative" flex=1 min-height=180 margin="0px 12px" overflow="hidden" border-radius=20 background-color="#0b0b0b"
            canvas surface=world(mode=orbitMode, home=orbitHome, reduced_motion=media.prefersReducedMotion) testId="world" width="100%" height="100%" position="absolute" inset=0 touch-action="none" aria-label="Wireframe sphere. Drag to revolve. Arrow keys or directional buttons also move the view." tabindex=0
              row position="absolute" left=16 right=16 top=16 justify-content="space-between" pointer-events="none"
                text "02 / ORBIT STUDY" font-size=10 letter-spacing="0.12em" color="#969696"
                text orbit.motion testId="orbit-motion" font-size=10 letter-spacing="0.08em" color="#b0b0b0"
              row position="absolute" bottom=14 left=0 right=0 gap=6 justify-content="center"
                button action="west" testId="orbit-west" min-width=44 min-height=44 border-radius=10 background-color="#202020" aria-label="Revolve west"
                  text "←"
                button action="north" testId="orbit-north" min-width=44 min-height=44 border-radius=10 background-color="#202020" aria-label="Revolve north"
                  text "↑"
                button action="south" testId="orbit-south" min-width=44 min-height=44 border-radius=10 background-color="#202020" aria-label="Revolve south"
                  text "↓"
                button action="east" testId="orbit-east" min-width=44 min-height=44 border-radius=10 background-color="#202020" aria-label="Revolve east"
                  text "→"
            box testId="reticle" position="absolute" left="50%" top="50%" width=0 height=0 pointer-events="none"
              box position="absolute" left=-11 top=-1 width=7 height=2 background-color="#ffffff"
              box position="absolute" left=4 top=-1 width=7 height=2 background-color="#ffffff"
              box position="absolute" left=-1 top=-11 width=2 height=7 background-color="#ffffff"
              box position="absolute" left=-1 top=4 width=2 height=7 background-color="#ffffff"
              box position="absolute" left=-1 top=-1 width=2 height=2 background-color="#ffffff"
          column padding="14px 20px 18px" gap=8 flex-shrink=0
            row justify-content="space-between" align-items="center" gap=8
              column gap=4
                text "UNDER THE CURSOR" font-size=10 letter-spacing="0.1em" color="#898989"
                text orbit.cell testId="orbit-cell" font-variant-numeric="tabular-nums" font-size=19 font-weight=500
              column gap=4 align-items="flex-end"
                text "ALTITUDE / LOCKED" font-size=10 letter-spacing="0.1em" color="#898989"
                text `${round(orbit.altitude * 10) / 10} ${orbit.altitude == 1 ? "UNIT" : "UNITS"}` testId="orbit-altitude" font-variant-numeric="tabular-nums" font-size=11 color="#b7b7b7"
            text orbit.mode testId="orbit-state" font-size=12 color="#aaaaaa"
            text (media.prefersReducedMotion ? "Drag to revolve · reduced motion, no drift" : "Drag to revolve · lift to drift · touch to catch") testId="orbit-help" font-size=12 color="#aaaaaa"
