shape Hud
  title: string
  detail: string
  selected: bool
  entered: bool
  travelling: bool
  altitude: number
  active: bool
  hover_title: string
  hover_id: string
  solid_name: string

component Ansuz
  state again = false
  state reduced = false
  resource hud = exactSurface("world") as shape Hud
  action restart
    again = not again
  action motion
    reduced = not reduced
  view
    main width="100%" height="100%" background-color="#090909" color="#dedede"
      canvas surface=world(restart=again, reduced=reduced) testId="world" width="100%" height="100%" position="relative"
        row position="absolute" top="env(safe-area-inset-top, 0px)" left=0 right=0 padding=20 justify-content="space-between" align-items="center" gap=12
          column gap=3
            text "ANSUZ" font-size="1.3rem" letter-spacing="0.22em" font-weight=600
            text "an atlas of attention" font="-exact-caption1" color="#a0a0a0"
          button press=restart testId="reset" aria-label="Return to the starting view" padding=12 border-radius=12 background-color="#252525"
            text "Recenter"
        column position="absolute" bottom="env(safe-area-inset-bottom, 0px)" left=0 right=0 padding=20 gap=12 background-color="#090909e8"
          row align-items="center" justify-content="space-between" gap=12 flex-wrap="wrap"
            text (hud.entered ? "IN THE REGION" : "SURFACE ATLAS") font="-exact-caption1" letter-spacing="0.12em" color="#a0a0a0" testId="level"
            text "voxel study" font="-exact-caption1" color="#a0a0a0"
          text hud.title font="-exact-title2" testId="place"
          text hud.detail font="-exact-subheadline" color="#a0a0a0"
          if hud.active
            row gap=12 align-items="center" flex-wrap="wrap"
              text hud.hover_title font="-exact-caption1" color="#b7d8de" testId="hover-title"
              text hud.solid_name font="-exact-caption1" testId="solid-name"
              button action="solid-prev" testId="solid-prev" aria-label="Previous Platonic solid (Q)" padding=10 border-radius=10 background-color="#252525"
                text "Previous solid"
              button action="solid-next" testId="solid-next" aria-label="Next Platonic solid (E)" padding=10 border-radius=10 background-color="#252525"
                text "Next solid"
          row gap=12 flex-wrap="wrap"
            button action="next" testId="next" padding=12 border-radius=12 background-color="#252525" disabled=hud.travelling
              text "Next region"
            if hud.entered
              button action="ascend" testId="ascend" padding=12 border-radius=12 background-color="#d0d0d0" color="#090909" disabled=hud.travelling
                text "Ascend"
            else
              button action="descend" testId="descend" padding=12 border-radius=12 background-color="#d0d0d0" color="#090909" disabled=(not hud.selected or hud.travelling)
                text (hud.travelling ? "Travelling…" : "Descend")
            button press=motion testId="motion" padding=12
              text (reduced ? "Gentle motion: on" : "Gentle motion")
