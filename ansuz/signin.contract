// Adapted from Jera foundation/app/signin.contract (67092b6).
// Exact owns popover dismissal and focus mechanics; Ansuz keeps its grayscale surface.
style AccountRow
  background-color = "#202020"
  :hover
    background-color = "#303030"
  :focus-visible
    background-color = "#353535"
  :active
    background-color = "#404040"

// The initial remains underneath while the public image loads, or if it fails.
component AccountAvatar
  props
    src: string
    label: string
  state failedSource = ""
  action failedImage(message: string)
    failedSource = src
  view
    box width=40 height=40 flex-shrink=0 border-radius=8 overflow="hidden" background-color="#353535" position="relative" display="flex" align-items="center" justify-content="center" aria-hidden=true
      text label.slice(0, 1).toUpperCase() color="#cccccc" font-size=17
      if src != "" and failedSource != src
        image src width="100%" height="100%" position="absolute" inset=0 object-fit="cover" error=failedImage alt=""
