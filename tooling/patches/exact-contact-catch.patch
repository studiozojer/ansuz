+extension NodeView {
+    func transformDragHitPoint(_ point: CGPoint, from parent: UIView) -> CGPoint? {
+        guard superview === parent, presenter?.transformBindings.values.contains(where: { $0.target == id }) == true,
+              layer.animationKeys()?.isEmpty == false, let displayed = layer.presentation() else { return nil }
+        // Transform-drag targets are centred affine pairs. UIKit's model
+        // conversion hits their destination while Core Animation still draws
+        // them elsewhere; invert the displayed pair for contact hit testing.
+        let offset = CGPoint(x: point.x - center.x, y: point.y - center.y)
+            .applying(displayed.affineTransform().inverted())
+        return CGPoint(x: offset.x + bounds.midX, y: offset.y + bounds.midY)
+    }
+}
