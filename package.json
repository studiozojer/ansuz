{
  "name": "ansuz",
  "version": "0.1.0",
  "private": true,
  "description": "EAS delivery configuration for the native Exact app",
  "scripts": {
    "build:ios": "eas build --platform ios --profile preview",
    "build:simulator": "eas build --platform ios --profile simulator",
    "check:delivery": "node --test scripts/delivery.test.cjs",
    "build:ios:local": "bash scripts/patch-exact.sh && \"${BUN:-bun}\" ansuz/exact.mjs ios --device --run",
    "web": "cd stratum-008 && ./exact.mjs web",
    "test:reading": "cd stratum-008 && ./exact.mjs test web",
    "web:shared": "node stratum-007/tools/shared-preview.mjs",
    "web:007": "cd stratum-007 && ./exact.mjs web",
    "test:reading:007": "cd stratum-007 && ./exact.mjs test web",
    "setup:008": "node stratum-008/tools/import-zhouyi.mjs",
    "build:offline": "npm --prefix stratum-008 run build"
  },
  "devDependencies": {
    "eas-cli": "27.2.0",
    "expo-modules-autolinking": "58.0.16"
  }
}
