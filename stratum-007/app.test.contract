test "the source question opens into an image and a deeper inquiry"
  expect text "reading-question" == "What is ready to take root?"
  expect tree missing "reading-body"
  tap "toggle-reading"
  expect tree has "image-passage"
  tap "inquiry-lens"
  expect tree missing "image-passage"
  expect text "inquiry-passage" == "What would you keep tending even if no one could see it yet?"
  expect text "reading-question" == "What is ready to take root?"
  tap "toggle-reading"
  expect tree missing "inquiry-passage"
  tap "toggle-reading"
  expect tree has "inquiry-passage"
  tap "image-lens"
  expect tree has "image-passage"
